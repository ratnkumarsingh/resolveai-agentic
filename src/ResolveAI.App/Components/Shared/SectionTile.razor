@* A glossy icon tile for a section heading. Decorative: the heading beside it says what the section is. *@
<span aria-hidden="true" class="@Ui.Cx("gloss grid h-7 w-7 shrink-0 place-items-center rounded-lg text-white", Look.Tile)">
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@Look.Path" /></svg>
</span>

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";

    private (string Tile, string Path) Look => Kind switch
    {
        "facts" => ("tile-green", "M4 6h2M4 12h2M4 18h2M10 6h10M10 12h10M10 18h10"),
        "analysis" => ("tile-violet", "M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8zM19 16v4M17 18h4"),
        "limits" => ("tile-amber", "M12 3 2 20h20L12 3zM12 10v4M12 17.5v.01"),
        "notes" => ("tile-sky", "M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6zM9 12l2 2 4-4"),
        "metrics" => ("tile-blue", "M4 20V10M10 20V4M16 20v-7M22 20H2"),
        "signals" => ("tile-red", "M3 12h4l3 8 4-16 3 8h4"),
        "guides" => ("tile-green", "M12 6c-2-1.5-5-2-8-2v14c3 0 6 .5 8 2 2-1.5 5-2 8-2V4c-3 0-6 .5-8 2zM12 6v14"),
        "timeline" => ("tile-violet", "M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"),
        "verify" => ("tile-green", "M8 12l3 3 5-6M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"),
        "source" => ("tile-blue", "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zM4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"),
        "key" => ("tile-amber", "M6 11h12v9H6zM9 11V8a3 3 0 0 1 6 0v3"),
        "reset" => ("tile-red", "M4 4v6h6M20 20v-6h-6M20 9a8 8 0 0 0-14-3L4 10M4 15a8 8 0 0 0 14 3l2-4"),
        _ => ("tile-blue", "M4 12h16"),
    };
}
