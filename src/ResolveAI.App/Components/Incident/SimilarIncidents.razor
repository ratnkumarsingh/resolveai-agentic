@if (Inv is null || Inv.Status != "completed")
{
    <Empty Title="Similar incidents appear after an investigation">The search runs over past incidents and RCA notes as part of “Run investigation”.</Empty>
}
else if (Inv.SimilarIncidents.Count == 0)
{
    <Empty Title="No closely related incidents found">The available history did not contain enough shared symptoms, error patterns, service details, or recent changes to identify a close match. You can still review the current incident findings and connected-source checks.</Empty>
}
else
{
    <div class="space-y-3">
        <p class="text-xs text-slate-500">Retrieved by full-text search over past incidents, ranked by matching terms and service. The explanation of each match is model-written.</p>
        @foreach (var s in Inv.SimilarIncidents)
        {
            <SimilarCard @key="s.Historical.Id" S="s" Focus="@Focus" />
        }
    </div>
}

@code {
    [Parameter] public Investigation? Inv { get; set; }
    [Parameter] public string? Focus { get; set; }
}
