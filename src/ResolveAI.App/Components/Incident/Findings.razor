@if (Inv is null)
{
    <div class="space-y-4">
        @if (Evidence is not null)
        {
            <ObservedFacts Evidence="Evidence" />
        }
        <Empty Title="No investigation yet">
            <p>Start an investigation to collect information from the incident, compare it with past incidents, and identify the most likely cause.</p>
            <Btn Class="mt-3" OnClick="OnRun">Start investigation</Btn>
        </Empty>
    </div>
}
else if (Inv.Status is "queued" or "running")
{
    <InvestigationBoard Inv="Inv" />
}
else if (Inv.Status == "failed")
{
    <div class="space-y-4">
        @if (!HasUsefulObservations)
        {
            <ErrorBox Message="@FriendlyInvestigationError" OnRetry="OnRun" />
        }
        @if (Evidence is not null)
        {
            <ObservedFacts Evidence="Evidence" />
        }
    </div>
}
else
{
    <div class="space-y-4" data-testid="investigation-results">
        @if (Inv.InsufficientEvidence || Inv.Hypotheses.Count == 0)
        {
            <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900" data-testid="insufficient-evidence">
                <strong>There is not enough information to identify the cause yet.</strong>
                We could not find enough reliable details in the available records to explain what happened.
                Add more incident details, logs, measurements, or recent changes, then start the investigation again.
            </div>
        }
        else
        {
            <LeadingHypothesis Inv="Inv" H="Inv.Hypotheses[0]" OnEvidence="OnEvidence" OnOpenRca="OnOpenRca" />
        }

        @if (Evidence is not null)
        {
            <ObservedFacts Evidence="Evidence" />
        }

        <section class="rounded-lg border border-slate-200 bg-surface p-4">
            <div class="mb-2 flex flex-wrap items-center gap-2">
                <SectionTile Kind="analysis" />
                <h3 class="text-sm font-semibold text-slate-900">Investigation summary</h3>
                <AiBadge>@(Inv.LlmMode == "live" ? $"AI-generated ({Inv.ModelName ?? "Claude"}) — not confirmed" : "Recorded analysis — not confirmed")</AiBadge>
                <span class="ml-auto text-xs text-slate-500">
                    @Inv.EvidenceCount information items reviewed · completed @Ui.FormatTime(Inv.CompletedAt)
                </span>
            </div>
            <p class="text-sm text-slate-800">@Inv.Summary</p>
            @if (!string.IsNullOrEmpty(Inv.Question))
            {
                <p class="mt-2 text-xs text-slate-500">Question asked: “@Inv.Question”</p>
            }
        </section>

        <div id="hypothesis-list" class="stagger scroll-mt-4 space-y-3">
            @foreach (var h in Inv.Hypotheses)
            {
                <HypothesisCard @key="h.Id" H="h" InvestigationId="@Inv.Id" OnEvidence="OnEvidence" OnChanged="OnChanged" />
            }
        </div>

        @if (Inv.Limitations.Count > 0 || Inv.ValidationIssues.Count > 0)
        {
            <div class="grid gap-4 md:grid-cols-2">
                @if (Inv.Limitations.Count > 0)
                {
                    <Card Title="Limitations" Icon="limits">
                        <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700">
                            @foreach (var l in Inv.Limitations)
                            {
                                <li>@l</li>
                            }
                        </ul>
                    </Card>
                }
                @if (Inv.ValidationIssues.Count > 0)
                {
                    <Card Title="Validation notes" Icon="notes">
                        <ul class="list-disc space-y-1 pl-5 text-sm text-slate-600">
                            @foreach (var l in Inv.ValidationIssues)
                            {
                                <li>@l</li>
                            }
                        </ul>
                    </Card>
                }
            </div>
        }

        <TracePanel Trace="Inv.Trace" Calls="Inv.ToolCalls" Live="@(Inv.LlmMode == "live")" />

        <div id="verified-cause" class="scroll-mt-4">
            <VerifiedCauseForm @key="Inv.Id" Inv="Inv" OnChanged="OnChanged" />
        </div>
    </div>
}

@code {
    [Parameter] public Investigation? Inv { get; set; }
    [Parameter] public IncidentEvidence? Evidence { get; set; }
    [Parameter] public EventCallback<string> OnEvidence { get; set; }
    [Parameter] public EventCallback OnRun { get; set; }
    [Parameter] public EventCallback OnOpenRca { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool HasUsefulObservations => Evidence is not null
        && (Evidence.Logs.Count > 0
            || Evidence.ErrorSignals.Count > 0
            || Evidence.Deployments.Count > 0
            || Evidence.Metrics.Count > 0);

    private string FriendlyInvestigationError => Inv?.ErrorMessage switch
    {
        null or "" => "We couldn't find a reliable match in the available incident data. Add more details, logs, metrics, or recent changes, then try the investigation again.",
        var message when message.Contains("did not match the expected format", StringComparison.OrdinalIgnoreCase)
            || message.Contains("could not be parsed", StringComparison.OrdinalIgnoreCase)
            => "We couldn't turn the analysis into a reliable result for this incident. Please add more incident details or supporting records, then try again.",
        var message when message.Contains("not enough information", StringComparison.OrdinalIgnoreCase)
            => "There isn't enough matching information in the available records yet. Add more incident details, logs, metrics, or recent changes, then try again.",
        _ => Inv.ErrorMessage!
    };
}
