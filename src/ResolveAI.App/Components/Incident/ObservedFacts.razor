@* Facts computed directly from records, shown apart from anything the model inferred. *@
<Card Icon="facts">
    <TitleContent>
        <span class="flex items-center gap-2">Observed facts <span class="rounded-sm bg-emerald-100 px-1.5 py-0.5 text-xs font-medium text-emerald-700">from records — not AI</span></span>
    </TitleContent>
    <ChildContent>
        @if (Facts.Count == 0)
        {
            <p class="text-sm text-slate-500">The available records did not contain error signals, recent deployments, or significant metric changes that could be related to this incident.</p>
        }
        else
        {
            <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700">
                @foreach (var f in Facts)
                {
                    <li @key="f">@f</li>
                }
            </ul>
        }
    </ChildContent>
</Card>

@code {
    [Parameter, EditorRequired] public IncidentEvidence Evidence { get; set; } = new();

    private List<string> Facts
    {
        get
        {
            var start = Js.ParseDate(Evidence.Incident.StartedAt);
            double MinutesBefore(Deployment d) => (start - Js.ParseDate(d.DeployedAt)).TotalMinutes;
            var facts = new List<string>();
            if (Evidence.Logs.Find(l => l.Level == "ERROR") is { } firstError)
            {
                facts.Add($"A request failure was recorded at {Ui.FormatTime(firstError.Timestamp)}: {firstError.Message} (technical detail: error log from {firstError.ServiceName}).");
            }

            facts.AddRange(Evidence.ErrorSignals.Take(3).Select(s =>
                $"The same type of error occurred {s.Count} time{(s.Count == 1 ? "" : "s")} between {Ui.FormatTime(s.FirstSeen)} and {Ui.FormatTime(s.LastSeen)} (technical signature: {s.Signature})."));

            facts.AddRange(Evidence.Deployments.Where(d => MinutesBefore(d) is >= 0 and <= 120).Select(d =>
                $"A recent change was released for {d.ServiceName} about {Js.Num(Js.Round(MinutesBefore(d)))} minute{(Js.Round(MinutesBefore(d)) == 1 ? "" : "s")} before the incident started: {d.ChangeSummary} (technical version: {d.Version})."));

            facts.AddRange(Evidence.Metrics.Where(Ui.MovedSharply).Select(m =>
                $"{FriendlyMetric(m.Name)} changed significantly, increasing from {Ui.Number(m.Baseline)} to {Ui.Number(m.Peak)} {m.Unit} (technical metric: {m.Name})."));
            return facts.Distinct().ToList();
        }
    }

    private static string FriendlyMetric(string name) => name.ToLowerInvariant() switch
    {
        var value when value.Contains("latency") || value.Contains("p95") => "Request response time",
        var value when value.Contains("error") || value.Contains("failure") => "Error rate",
        var value when value.Contains("connection") || value.Contains("pool") => "Database connection usage",
        var value when value.Contains("cpu") => "Server CPU usage",
        var value when value.Contains("memory") => "Server memory usage",
        _ => "A service measurement",
    };
}
