@inject AppService Service
@inject NavigationManager Nav

@* The home page's first screen: where to start, one click from an investigation, and how the queue stands. Everything shown comes from stored records. *@
<section class="glow-panel rounded-2xl p-5 sm:p-7" data-testid="queue-hero">
    
    
    <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <div class="min-w-0" data-testid="spotlight">
            @if (Spotlight is null)
            {
                <p class="text-xs font-semibold uppercase tracking-wide label-gradient">All caught up</p>
                <h2 class="mt-1 text-2xl glow-text font-semibold tracking-tight sm:text-3xl">Nothing is waiting for you</h2>
                <p class="mt-2 max-w-xl text-sm text-slate-700">Every active incident has been investigated, and nothing needs review.</p>
            }
            else
            {
                <p class="text-xs font-semibold uppercase tracking-wide label-gradient">@(NeedsRun ? "Start here" : "Finish the review")</p>
                <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                    <span class="font-medium tabular-nums text-slate-600">@Spotlight.Key</span>
                    <SeverityChip Severity="@Spotlight.Severity" Live="@(Spotlight.Status is "open" or "investigating")" />
                    <span class="@Ui.Cx("rounded-sm px-1.5 py-0.5 text-xs font-medium", Ui.ServiceChip(Spotlight.ServiceName))">@Spotlight.ServiceName</span>
                </div>
                <h2 class="mt-2 text-2xl glow-text font-semibold tracking-tight sm:text-3xl">@Spotlight.Title</h2>
                <p class="mt-2 max-w-xl text-sm text-slate-700">@Spotlight.ImpactSummary</p>
                <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
                    @if (NeedsRun && Config.LlmMode != "live")
                    {
                        <button type="button" @onclick="Investigate" disabled="@_starting" data-testid="investigate-now"
                                class="inline-flex items-center gap-2 btn-primary rounded-md px-5 py-2.5 text-sm font-medium transition active:scale-[0.98] disabled:opacity-70 motion-reduce:transform-none">
                            @if (_starting)
                            {
                                <Spinner Class="h-4 w-4" />
                            }
                            Investigate now
                        </button>
                        <span class="text-xs text-slate-500">Read-only checks, recorded analysis. No model is called.</span>
                    }
                    else
                    {
                        <a href="/incidents/@Spotlight.Key" data-testid="spotlight-open"
                           class="inline-flex items-center btn-primary rounded-md px-5 py-2.5 text-sm font-medium transition active:scale-[0.98] motion-reduce:transform-none">
                            @(NeedsRun ? "Go to this incident" : "Review the findings")
                        </a>
                        @if (NeedsRun)
                        {
                            <span class="text-xs text-slate-500">Live runs use Claude and cost money, so you start them on the incident.</span>
                        }
                    }
                </div>
                @if (_error is not null)
                {
                    <div class="mt-3 text-slate-900"><ErrorBox Message="@_error" /></div>
                }
            }
        </div>
        <div class="grid grid-cols-2 gap-3 self-center">
            @Tile("active", "Active", Stats.Active, "text-indigo-800", "tile-blue", "M3 12h4l3 8 4-16 3 8h4", Active, "Show every incident")
            @Tile("sev1", "SEV-1", Stats.Sev1, "text-red-700", "tile-red", "M12 3 2 20h20L12 3zM12 10v4M12 17.5v.01", Sev1, "Show only SEV-1 incidents")
            @Tile("review", "Needs review", Stats.NeedsReview, "text-amber-700", "tile-amber", "M12 7v5l3 2M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", NeedsReview, "Show incidents waiting for a person to verify them")
            @Tile("verified", "Verified", Stats.Verified, "text-emerald-700", "tile-green", "M8 12l3 3 5-6M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z", Verified, "Show incidents a person has verified")
        </div>
    </div>
</section>

@code {
    public sealed record QueueStats(int Active, int Sev1, int NeedsReview, int Verified);

    [Parameter, EditorRequired] public QueueStats Stats { get; set; } = new(0, 0, 0, 0);
    [Parameter] public IncidentListItem? Spotlight { get; set; }
    [Parameter, EditorRequired] public AppConfig Config { get; set; } = new();
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Sev1 { get; set; }
    [Parameter] public bool NeedsReview { get; set; }
    [Parameter] public bool Verified { get; set; }
    [Parameter] public EventCallback<string> OnTile { get; set; }
    [CascadingParameter(Name = "IsLocal")] private bool IsLocal { get; set; }

    private bool _starting;
    private string? _error;

    private bool NeedsRun => Spotlight?.ReviewState == "none";

    private RenderFragment Tile(string key, string label, int count, string tone, string soft, string icon, bool pressed, string title) =>
        @<button type="button" title="@title" aria-pressed="@Ui.Aria(pressed)" @onclick="() => OnTile.InvokeAsync(key)" data-testid="@($"tile-{key}")"
                 class="@Ui.Cx("flex items-start justify-between gap-2 rounded-xl border bg-raised/70 p-3.5 text-left text-slate-900 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg active:scale-[0.98] motion-reduce:transform-none", pressed ? "border-indigo-500 ring-1 ring-indigo-500" : "border-slate-200")">
            <span>
                <span @key="count" class="@Ui.Cx("pop block text-3xl font-semibold leading-none tabular-nums", count == 0 ? "text-slate-500" : tone)">@count</span>
                <span class="mt-1.5 block text-xs font-medium text-slate-600">@label</span>
            </span>
            <span aria-hidden="true" class="@Ui.Cx("gloss grid h-9 w-9 shrink-0 place-items-center rounded-lg text-white", soft)">
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="@icon" /></svg>
            </span>
        </button>;

    private void Investigate()
    {
        if (Spotlight is null) return;
        _starting = true;
        _error = null;
        try
        {
            // Always recorded: one click here can never start a paid run.
            Service.StartInvestigation(Spotlight.Key, new StartInvestigationBody { Mode = "recorded" }, new Caller(null, IsLocal));
            Nav.NavigateTo($"/incidents/{Spotlight.Key}");
        }
        catch (Exception err)
        {
            _starting = false;
            _error = Ui.Message(err);
        }
    }
}
