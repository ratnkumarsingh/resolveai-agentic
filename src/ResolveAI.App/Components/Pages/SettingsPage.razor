@page "/settings"
@inject AppService Service
@inject AccessCodeStore Codes

<PageTitle>ResolveAI</PageTitle>

<div class="page-enter max-w-2xl space-y-4">
    <h1 class="text-xl font-semibold">Settings &amp; demo data</h1>

    <Card Title="Data source" Icon="source">
        <dl class="grid grid-cols-[10rem_1fr] gap-y-2 text-sm">
            <dt class="text-slate-500">Mode</dt>
            <dd class="font-medium">Demo dataset</dd>
            <dt class="text-slate-500">Integrations</dt>
            <dd>None connected. Incidents, logs, deployments, and measurements come from the built-in demonstration data, not live systems.</dd>
            <dt class="text-slate-500">LLM mode</dt>
            <dd>
                @if (_config.LlmMode == "live")
                {
                    <text>Live — investigations call the configured model (<span class="tabular-nums">@_config.Model</span>) from the server.</text>
                }
                else
                {
                    <text>Recorded by default — investigations replay a recorded analysis (INC-1042) or deterministic rules. No model is called.</text>
                }
            </dd>
            <dt class="text-slate-500">Live model</dt>
            <dd>
                @if (_config.LiveAvailable)
                {
                    <text>Available on request (<span class="tabular-nums">@_config.LiveModel</span>) · @_config.LiveRunsToday of @_config.LiveDailyLimit model calls used today (UTC).</text>
                }
                else
                {
                    <text>Not available on this server (needs a configured live provider and LIVE_ACCESS_CODE).</text>
                }
            </dd>
        </dl>
    </Card>

    <Card Title="Access code" Icon="key">
        <p class="text-sm text-slate-600">
            Live model runs may incur usage costs, so they need the access code set on the server (<span class="font-mono">LIVE_ACCESS_CODE</span>).
            It also allows demo reset from outside localhost. The code is kept only in this browser.
        </p>
        <form class="mt-3 flex flex-wrap items-center gap-2" @onsubmit="SaveCode" @onsubmit:preventDefault="true">
            <input type="password" @bind="_code" @bind:event="oninput" placeholder="Access code" aria-label="Access code" autocomplete="off"
                   class="w-64 rounded-md border border-slate-300 px-3 py-1.5 text-sm" />
            <Btn Type="submit" Disabled="@(_code.Trim() == Codes.Current)">Save</Btn>
            @if (Codes.Current.Length > 0)
            {
                <Btn Variant="ghost" OnClick="ForgetCode">Forget</Btn>
            }
            <span class="text-xs text-slate-500">@(Codes.Current.Length > 0 ? "Saved in this browser." : "No code saved.")</span>
        </form>
    </Card>

    <Card Title="Reset demo data" Icon="reset">
        <p class="text-sm text-slate-600">
            Deletes all investigations, feedback and RCA drafts and restores the seeded incidents, so the demo can be run again from a known state.
        </p>
        <div class="mt-3 flex items-center gap-2">
            @if (!_confirming)
            {
                <Btn OnClick="() => _confirming = true" Disabled="@(!_config.DemoMode)">Reset demo data…</Btn>
            }
            else
            {
                <Btn Variant="danger" OnClick="Reset">Yes, reset everything</Btn>
                <Btn Variant="ghost" OnClick="() => _confirming = false">Cancel</Btn>
            }
            @if (_resetDone && !_confirming)
            {
                <span class="text-sm text-emerald-700">Demo data restored.</span>
            }
        </div>
        @if (!_config.DemoMode)
        {
            <p class="mt-2 text-xs text-slate-500">Disabled: the server is not running with DEMO_MODE=true.</p>
        }
        @if (_resetError is not null)
        {
            <div class="mt-3"><ErrorBox Message="@_resetError" /></div>
        }
    </Card>
</div>

@code {
    [CascadingParameter(Name = "IsLocal")] private bool IsLocal { get; set; }

    private AppConfig _config = new();
    private bool _confirming;
    private bool _resetDone;
    private string? _resetError;
    private string _code = "";

    protected override void OnInitialized() => _config = Service.Config();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Codes.Load();
        _code = Codes.Current;
        StateHasChanged();
    }

    private async Task SaveCode() => await Codes.Set(_code.Trim());

    private async Task ForgetCode()
    {
        await Codes.Set("");
        _code = "";
    }

    private void Reset()
    {
        _resetError = null;
        _resetDone = false;
        try
        {
            Service.DemoReset(new Caller(Codes.Current, IsLocal));
            _confirming = false;
            _resetDone = true;
            _config = Service.Config();
        }
        catch (Exception err)
        {
            _resetError = Ui.Message(err);
        }
    }
}
