@page "/systems"
@implements IDisposable
@inject AppService Service

<PageTitle>ResolveAI</PageTitle>

<div class="page-enter space-y-6">
    <section class="glow-panel rounded-2xl p-5 sm:p-7">
        
        
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide label-gradient">Connected information sources</p>
            <h1 class="mt-1 text-2xl glow-text font-semibold tracking-tight sm:text-3xl">Systems ResolveAI can check</h1>
            <p class="mt-2 max-w-2xl text-sm text-slate-700">
                ResolveAI can review information from these systems without changing them. It only uses the checks shown here; it cannot run arbitrary commands or modify your systems.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
                @foreach (var s in SystemStyle.Order)
                {
                    var st = _systems.Systems.FirstOrDefault(x => x.System == s);
                    <span class="inline-flex items-center gap-1.5 rounded-md bg-raised px-2.5 py-1 text-xs font-medium text-slate-800 ring-1 ring-slate-200">
                        @if (st is not null)
                        {
                            <StatusDot Status="@st.Status" />
                        }
                        else
                        {
                            <span class="h-2.5 w-2.5 rounded-full bg-white/40"></span>
                        }
                        @SystemStyle.Of(s).Label
                    </span>
                }
            </div>
        </div>
    </section>

    @if (!_systems.Enabled)
    {
        <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
            Connected system checks are turned off here. Investigations are using the built-in demonstration data instead.
        </div>
    }

    @if (_systems.Systems.Count > 0)
    {
        <div class="stagger grid gap-4 md:grid-cols-2" data-testid="systems-grid">
            @foreach (var sys in SystemStyle.Order)
            {
                var st = _systems.Systems.FirstOrDefault(x => x.System == sys);
                if (st is null) continue;
                var s = SystemStyle.Of(sys);
                <article class="@Ui.Cx("flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-surface shadow-sm", st.Status == "disabled" ? "opacity-90" : null)" data-testid="system-@sys">
                    <div class="@Ui.Cx("h-1", s.Bar)"></div>
                    <div class="flex flex-1 flex-col gap-3 p-4">
                        <header class="flex items-start gap-3">
                            <SystemTile System="@sys" Size="lg" />
                            <div class="min-w-0 flex-1">
                                <h2 class="text-base font-semibold text-slate-900">@st.Label</h2>
                                <p class="text-xs text-slate-500">@s.Label · server <span class="tabular-nums">@st.Server</span></p>
                            </div>
                            <span class="@Ui.Cx("inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium ring-1",
                                               st.Status switch { "connected" => "bg-emerald-50 text-emerald-800 ring-emerald-200", "error" => "bg-red-50 text-red-800 ring-red-200", _ => "bg-slate-50 text-slate-600 ring-slate-200" })">
                                <StatusDot Status="@st.Status" Pulse="@(st.Status == "connected")" />
                                @(st.Status switch { "connected" => "Connected", "error" => "Not working", _ => "Turned off" })
                            </span>
                        </header>
                        <p class="text-sm text-slate-700">@s.Blurb</p>
                        @if (!string.IsNullOrEmpty(st.Detail))
                        {
                            <p class="@Ui.Cx("rounded-md px-2.5 py-1.5 text-xs", st.Status == "error" ? "bg-red-50 text-red-800" : "bg-slate-50 text-slate-600")">@st.Detail</p>
                        }
                        @if (st.Tools.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var t in st.Tools)
                                {
                                    <span title="@t.Description" class="@Ui.Cx("rounded-md px-2 py-0.5 tabular-nums text-xs font-medium", s.Chip)">@t.Name</span>
                                }
                            </div>
                        }
                        <p class="mt-auto pt-1 text-[11px] text-slate-400">
                            @st.Tools.Count check@(st.Tools.Count == 1 ? "" : "s") available · checked @Ui.FormatTime(st.CheckedAt, true)
                        </p>
                    </div>
                </article>
            }
        </div>
    }

    <section class="rounded-xl border border-slate-200 bg-surface p-5 shadow-sm">
        <h2 class="text-sm font-semibold text-slate-800">How an investigation uses them</h2>
        <ol class="mt-3 grid gap-3 md:grid-cols-3">
            @foreach (var (n, title, body) in Steps)
            {
                <li class="flex gap-3 rounded-lg bg-slate-50 p-3">
                    <span class="@Ui.Cx("node grid h-7 w-7 shrink-0 place-items-center rounded-full text-sm font-semibold", n == 1 ? "node-lilac" : n == 2 ? "node-sky" : "node-mint")">@n</span>
                    <div>
                        <div class="text-sm font-semibold text-slate-800">@title</div>
                        <p class="text-xs text-slate-600">
                            @body
                            @if (n == 2)
                            {
                                <text> Limit: <strong>@_config.MaxFollowUpCalls</strong> calls per run.</text>
                            }
                        </p>
                    </div>
                </li>
            }
        </ol>
    </section>
</div>

@code {
    private static readonly (int N, string Title, string Body)[] Steps =
    [
        (1, "Initial checks", "ResolveAI reviews the same basic information for the affected service and time period."),
        (2, "Focused follow-up checks", "When enabled, the assistant can ask a few targeted questions to learn more."),
        (3, "Review", "The results are compared with the incident details before an explanation is shown."),
    ];

    private SystemsResponse _systems = new() { Enabled = true };
    private AppConfig _config = new();
    private Timer? _timer;

    protected override void OnInitialized()
    {
        _systems = Service.Systems();
        _config = Service.Config();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            _systems = Service.Systems();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => _timer?.Dispose();
}
